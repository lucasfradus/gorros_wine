# Copiar a .env.local y completar. .env.local NO se versiona.

# Base de datos. El valor de abajo es el del docker-compose de desarrollo.
DATABASE_URL="postgres://gorros:gorros_dev@localhost:5432/gorros"

# URL pública del sitio, sin barra final. Se usa para el sitemap y las
# tarjetas de Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Bucket S3 de las imágenes que se suben desde el panel (Contenido).
#
# Los valores salen de `railway bucket credentials --bucket gorros-media --json`
# o de la pestaña Credentials del bucket. Ojo: `S3_BUCKET` no es el nombre que
# se ve en el canvas de Railway sino el `bucketName` de las credenciales, que
# lleva un hash al final. El endpoint tampoco es el mismo para todos los
# buckets: copiar el que devuelvan las credenciales.
#
# Sin esto el proyecto levanta igual: no se pueden subir imágenes y el sitio
# muestra las que vinieron con el diseño.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT=""

# Poner en 1 sólo si las credenciales dicen `"urlStyle": "path"`. Los buckets
# nuevos usan `virtual-host` y no lo necesitan.
S3_PATH_STYLE=""

# ── Facturación ─────────────────────────────────────────────────────────────
# Sin estas variables el panel muestra la pantalla de Facturación con un aviso
# y no emite nada.

# Facturante.com: el intermediario que habla con ARCA (certificado, CAE, PDF).
# Producción es https://sync.facturante.com; testing, https://synctest.facturante.com.
FACTURANTE_BASE_URL="https://sync.facturante.com"
# El usuario es un mail. Si se copia de un correo, sacarle el `mailto:`.
FACTURANTE_USERNAME=""
FACTURANTE_PASSWORD=""
FACTURANTE_COMPANY_ID=""
FACTURANTE_SUBSIDIARY_ID=""
# Id INTERNO del punto de venta en Facturante (ej. 13665), no su número (00015).
FACTURANTE_POS_ID=""
# Secreto que Facturante nos reenvía en el webhook de "comprobante autorizado".
# Sin él no se pide el webhook. Sólo sirve desplegado: Facturante no llega a
# localhost. Generar con `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
FACTURANTE_WEBHOOK_SECRET=""

# El emisor: un solo CUIT para todo Gorros.
EMISOR_CUIT=""

# Mercado Pago: la app propia de Gorros (developers.mercadopago.com). La
# redirect URI tiene que estar registrada en la app tal cual.
MP_APP_ID=""
MP_CLIENT_SECRET=""
MP_REDIRECT_URI="http://localhost:3000/api/mercadopago/callback"
# 32 bytes en hex (64 caracteres). Cifra los tokens de MP en la base: si se
# cambia, hay que volver a vincular la cuenta.
MP_TOKEN_ENCRYPTION_KEY=""

# Lo que manda el servicio cron de Railway a POST /api/cron/diario.
CRON_SECRET=""
