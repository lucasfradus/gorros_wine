# Copiar a .env.local y completar. .env.local NO se versiona.

# Base de datos. El valor de abajo es el del docker-compose de desarrollo.
DATABASE_URL="postgres://gorros:gorros_dev@localhost:5432/gorros"

# URL pública del sitio, sin barra final. Se usa para el sitemap y las
# tarjetas de Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Bucket S3 de las imágenes que se suben desde el panel (Contenido).
#
# Los valores salen de `railway bucket credentials --bucket gorros-media --json`
# o de la pestaña Credentials del bucket. Ojo: `S3_BUCKET` no es el nombre que
# se ve en el canvas de Railway sino el `bucketName` de las credenciales, que
# lleva un hash al final. El endpoint tampoco es el mismo para todos los
# buckets: copiar el que devuelvan las credenciales.
#
# Sin esto el proyecto levanta igual: no se pueden subir imágenes y el sitio
# muestra las que vinieron con el diseño.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
S3_ENDPOINT=""

# Poner en 1 sólo si las credenciales dicen `"urlStyle": "path"`. Los buckets
# nuevos usan `virtual-host` y no lo necesitan.
S3_PATH_STYLE=""
